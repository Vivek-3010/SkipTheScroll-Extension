{
  "manifest_version": 3,
  "name": "SkipTheScroll",
  "version": "1.0.0",
  "description": "Skip thousands of comments. Get the answer in seconds. Analyses YouTube comments to tell you if a tutorial, review or fix actually works.",
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "SkipTheScroll",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "activeTab"],
  "host_permissions": [
    "http://localhost:5178/*",
    "http://127.0.0.1:5178/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
