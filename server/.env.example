# ---- SkipTheScroll backend ----
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# NEVER commit the real `.env` file. These keys stay on the server only.

# Port the Express server listens on (the extension defaults to http://localhost:5178)
PORT=5178

# Node environment: development | production
NODE_ENV=development

# ---- YouTube Data API v3 ----
# Google Cloud Console -> enable "YouTube Data API v3" -> Credentials -> API key.
# The project behind the key must have the API enabled.
# Paste ONLY the key value: no quotes, no "Bearer ", no spaces, not the whole line.
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# ---- Groq (AI analysis) ----
# Create a key at https://console.groq.com/keys
# Paste ONLY the key value: no quotes, no "Bearer ", no spaces, not the whole line.
# SkipTheScroll only checks for paste damage - any prefix or format is accepted.
# The key stays on this server and is never sent to the Chrome extension.
GROQ_API_KEY=

# Model used for analysis (one pass when the comments fit, otherwise paced
# extraction batches + a final synthesis pass).
# Check what your key can actually reach:  npm run check:groq
GROQ_MODEL=openai/gpt-oss-120b

# Max output tokens per call (shared with reasoning). The free tier budgets
# ~8k tokens/minute TOTAL per request, so this also has to fit the prompt:
#   prompt_tokens + max_tokens must stay under ~8000 or Groq rejects the
#   request before it runs (HTTP 413). 3072 is the measured sweet spot for the
#   final verdict pass. Raise GROQ_MAX_TOKENS only if you see GROQ_EMPTY with
#   finish_reason=length, and lower GROQ_REQUEST_TOKEN_BUDGET to compensate.
GROQ_MAX_TOKENS=3072

# Per-request free-tier ceiling: prompt + max_tokens must stay under this or
# Groq answers HTTP 413 before the model runs. Large comment sections are split
# into batches sized against it, so the whole comment section is still read.
# Only lower this for a stricter free tier; never raise it above your real limit.
GROQ_REQUEST_TOKEN_BUDGET=8000

# Reasoning models (openai/gpt-oss-*) are always sent reasoning_effort=low,
# which cuts the "thinking" tokens by roughly 6x and keeps latencies under ~5s.
# There is no knob for this - it is on for gpt-oss models automatically.

# Send one tiny real request to the configured model at startup and print the
# result, so a bad key / wrong model shows up before you click anything.
GROQ_STARTUP_CHECK=true

# ---- Comment cap (optional) ----

# How many top-level comment threads are fetched from YouTube AND analysed.
# This is no longer an AI-token limit: comment sections that do not fit one
# Groq request are split into paced batches automatically, so the default
# covers the vast majority of videos. 1-500; values above 500 are clamped.
MAX_COMMENTS=500

# Per-request timeouts
YOUTUBE_TIMEOUT_MS=15000
GROQ_TIMEOUT_MS=120000

# In-memory result cache (no database in V1). Set CACHE_TTL_MS=0 to disable.
# Repeated clicks on the same video inside this window cost zero AI calls.
CACHE_TTL_MS=600000
CACHE_MAX_ENTRIES=20