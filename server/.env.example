# ---- SkipTheScroll backend ----
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# NEVER commit the real `.env` file. These keys stay on the server only.

# Port the Express server listens on (the extension defaults to http://localhost:5178)
PORT=5178

# Node environment: development | production
NODE_ENV=development

# ---- YouTube Data API v3 ----
# Google Cloud Console -> enable "YouTube Data API v3" -> Credentials -> API key.
# The project behind the key must have the API enabled.
# Paste ONLY the key value: no quotes, no "Bearer ", no spaces, not the whole line.
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# ---- Gemini ----
# Create a key at https://aistudio.google.com/apikey
# Paste ONLY the key value: no quotes, no "Bearer ", no spaces, not the whole line.
# Any prefix or format is accepted; SkipTheScroll only checks for paste damage.
GEMINI_API_KEY=your_gemini_api_key_here

# Model used for the batch analysis and the final synthesis.
# Check what your key can actually reach:  npm run check:gemini
GEMINI_MODEL=gemini-3.8-flash

# REST API version. v1beta supports the widest range of models.
# Accepts "v1beta", "1beta" or "v1".
GEMINI_API_VERSION=v1beta

# Thinking budget in tokens.
# LEAVE UNSET (or empty / "auto" / "none") to send no thinkingConfig at all - the
# safest option, and required for models that reject an explicit budget.
# Set a positive number (e.g. 1024) or -1 to send thinkingConfig explicitly.
# Note: thinking tokens are counted against maxOutputTokens.
GEMINI_THINKING_BUDGET=auto

# Send one tiny request to the configured model at startup and print the result,
# so a bad key / wrong model / exhausted quota shows up before you click anything.
GEMINI_STARTUP_CHECK=true

# ---- V1 tuning knobs (all optional) ----

# Hard cap for V1. Values above 500 are clamped back to 500 on purpose.
MAX_COMMENTS=500

# Comments per Gemini batch.
# Calls per analysis = ceil(MAX_COMMENTS / GEMINI_BATCH_SIZE) + 1 synthesis call.
#   500 / 50  -> 11 calls   (default)
#   500 / 100 ->  6 calls
#   500 / 200 ->  4 calls
# This matters a lot on the Gemini free tier, which allows only a handful of
# requests per day PER MODEL.
GEMINI_BATCH_SIZE=50

# How many batches run in parallel (protects you from burst rate limits)
GEMINI_CONCURRENCY=3

# Per-request timeouts
YOUTUBE_TIMEOUT_MS=15000
GEMINI_TIMEOUT_MS=120000

# In-memory result cache (no database in V1). Set CACHE_TTL_MS=0 to disable.
# Repeated clicks on the same video inside this window cost zero Gemini calls.
CACHE_TTL_MS=600000
CACHE_MAX_ENTRIES=20
